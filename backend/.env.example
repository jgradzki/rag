# Copy this file to `.env` and fill in the values.

# Which LLM generates the answers: "anthropic" (Claude API) or "ollama" (local model)
LLM_PROVIDER=anthropic

# --- Claude (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max; empty = not sent (for a model without effort)
ANTHROPIC_EFFORT=low
# Output token limit of one answer - lower it for a model with a smaller limit
# ANTHROPIC_MAX_TOKENS=16000

# --- Ollama (https://ollama.com) - run `ollama pull qwen3:8b` first ---
# Smaller and faster, but weaker in non-English languages: llama3.2
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
# Leave commented out for the model's default (works for every model). true is
# rejected by models without a thinking mode (llama3.2). false = ~2x faster first
# token with qwen3, but answers stick less to the documents.
# OLLAMA_REASONING=false

# --- Embeddings (local; changing the model requires re-indexing, see README) ---
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Retrieval tuning (re-index after changing the chunking, see README) ---
# Keep chunks within the embedding model's 128-token limit (~450 characters).
# CHUNK_SIZE=450
# CHUNK_OVERLAP=70
# TOP_K=8
# MIN_RELEVANCE=0.2
# Maximal Marginal Relevance, 1.0 = off; try ~0.5 when documents repeat each other
# MMR_LAMBDA=1.0
# FETCH_K=20

# --- Sample documents (indexed on the first start only) ---
# INDEX_SAMPLES_ON_STARTUP=true
# SAMPLE_DOCS_DIR=sample_docs

# --- Uploads ---
# MAX_UPLOAD_MB=10
# MAX_UPLOAD_FILES=20

# --- Security ---
# Browser origins allowed to upload, delete and chat (JSON list). Add the address you
# browse to when you open the Docker app to your network (BIND_ADDRESS=0.0.0.0).
# "*" is not accepted: list every origin.
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080"]
